generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Business {
  id           String       @id @default(uuid())
  name         String
  users        User[]
  products     Product[]
  sales        Sale[]
  stockEntries StockEntry[]
  createdAt    DateTime     @default(now())
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  phone      String?
  businessId         String
  business           Business @relation(fields: [businessId], references: [id])
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  createdAt          DateTime @default(now())
}

model Product {
  id           String       @id @default(uuid())
  name         String
  description  String?
  barcode      String?
  buyPrice     Float
  sellPrice    Float
  stock        Int          @default(0)
  minStock     Int          @default(5)
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id])
  saleItems    SaleItem[]
  stockEntries StockEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([barcode, businessId])
}

model StockEntry {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  previousStock Int
  newStock      Int
  type          String   @default("ENTRY") // ENTRY, INITIAL, ADJUSTMENT
  notes         String?
  userName      String?
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  createdAt     DateTime @default(now())
}

model Sale {
  id         String     @id @default(uuid())
  total      Float
  businessId String
  business   Business   @relation(fields: [businessId], references: [id])
  items      SaleItem[]
  createdAt  DateTime   @default(now())
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float   // Precio al momento de la venta
}
